{
  "description": "Record the research trace and fork points: where the live session is, which step the agent entered, which registered source files it read, and the agent's state committed at the end of every turn.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx airas==0.4.0 hook session-start --harness claude",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uvx airas==0.4.0 hook step --harness claude",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uvx airas==0.4.0 hook access --harness claude",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx airas==0.4.0 hook capture --harness claude",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
